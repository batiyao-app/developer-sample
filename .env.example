# From batiyao.com → Settings → Developer → Register an app.
# The client ID is public; Batiyao issues no client secret (PKCE is used instead).
BATIYAO_CLIENT_ID=

# Must be registered on your app exactly as written.
# http://localhost is allowed while you are testing; use https:// in production.
PORT=3000
REDIRECT_URI=http://localhost:3000/callback

# Leave as is unless Batiyao tells you otherwise.
BATIYAO_API=https://api.batiyao.com
